# SH-205 backend configuration.
#
# Local development: copy to backend/.env and adjust. Never commit the real file.
# Production: set these in the host's dashboard (Render), not in a file.
#
# Every value below is a default that already works locally, except the
# Firebase ones, which need your project's values.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO
# Structured JSON logs; prefer true in production so the host can parse them.
LOG_JSON=false

# --- CORS ---
# Comma-separated list of exact origins allowed to call the API.
# In production this is the deployed frontend URL, e.g.
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500

# Vercel preview deployments get a generated hostname per build, so they are
# matched by pattern rather than listed. Set empty to allow only the above.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Database ---
# SQLite locally; relative paths resolve against backend/.
DATABASE_URL=sqlite:///./sh205.db

# In production, point at PostgreSQL. A `postgres://` URL from the host is
# rewritten to the psycopg driver automatically, so paste it verbatim:
#   DATABASE_URL=postgresql://user:password@host:5432/sh205

# Echo every SQL statement (very noisy; debugging only).
DB_ECHO=false

# --- E1 model ---
# Relative to backend/. The artifacts are read-only.
E1_ARTIFACT_DIR=artifacts/misplacement_classifier/v2
E1_EAGER_LOAD=true

# --- Firebase ---
# Service account, supplied one of two ways (JSON wins if both are set):
#
#   1. Production. The whole service-account JSON on a single line:
#      FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
#
#   2. Local. A path to the file, relative to backend/:
FIREBASE_CREDENTIALS_PATH=credentials/firebase-credentials.json

# firebase : every data route requires "Authorization: Bearer <ID token>"
# disabled : LOCAL DEVELOPMENT ONLY - every request is treated as a dev admin.
#            Refused outright when ENVIRONMENT=production.
AUTH_MODE=firebase

# Firebase web config, served to the browser by GET /auth/web-config so the
# static site can sign in without a build step. These four fields are public
# by design in Firebase and are NOT credentials. Locally they may be omitted,
# in which case they are read from frontend/.env.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Writes bounty offers / notifications to the LIVE Firestore project.
FIRESTORE_ENABLED=false
